# AUTO-GENERATED; DO NOT MODIFY;
# This template is rendered by kubara per-cluster from the `postgresql` service config.
#
# To customize values, add additional files named values-*.yaml to this directory.

{{- $cfg := (index .cluster.services "postgresql" "config") | default dict }}
{{- $db := $cfg.database | default dict }}
{{- $persist := $cfg.persistence | default dict }}

namespace:
  labels:
    project-name: "backing-services"
    stage: "{{ .cluster.stage | default "local" }}"

# Passwords are never rendered into these manifests. `auth.existingSecret`
# points at the `postgresql` Secret in the same namespace, which is populated
# from .env by z-demo-setup/scripts/create-platform-secrets.sh
# (POSTGRES_PASSWORD -> postgres-password, APP_POSTGRES_PASSWORD -> password)
# and mirrored to OpenBao.
auth:
  enablePostgresUser: true
  existingSecret: postgresql
  username: {{ $db.username | default "" | quote }}
  database: {{ $db.name | default "" | quote }}

primary:
{{- with $cfg.primary }}
{{- with .initdb }}
  initdb:
{{- with .scripts }}
    scripts:
{{ toYaml . | indent 6 }}
{{- end }}
{{- end }}
{{- end }}
  persistence:
    enabled: true
{{- with $persist.storageClass }}
    storageClass: {{ . | quote }}
{{- end }}
    size: {{ $persist.size | default "8Gi" | quote }}
