# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually in any way.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $ciliumConfig := (index .cluster.services "cilium" "config") -}}
{{- $kubePrometheusEnabled := eq (index .cluster.services "kube-prometheus-stack" "status") "enabled" -}}
cilium:
  # Per-cluster identity. cluster.id must be unique across the mesh for
  # ClusterMesh (1=hub, 2..6=spokes) and must match
  # z-demo-setup/config/kind-demo.yaml cilium_id. Static defaults (ingress
  # controller, hubble, ipam, ...) live in the chart's values.yaml.
  cluster:
    name: "{{ .cluster.name }}"
    id: {{ $ciliumConfig.clusterId }}
  {{- if $kubePrometheusEnabled }}
  # Only the hub runs Prometheus Operator, so only it can consume Cilium
  # ServiceMonitors. trustCRDsExist skips the chart's CRD probe so the
  # ServiceMonitors render even during a first-boot sync (mirrors
  # build-mesh.sh's install args).
  prometheus:
    serviceMonitor:
      enabled: true
      trustCRDsExist: true
      labels:
        monitoring.instance: "{{ .cluster.name }}-{{ .cluster.stage }}"
  hubble:
    metrics:
      serviceMonitor:
        enabled: true
        trustCRDsExist: true
        labels:
          monitoring.instance: "{{ .cluster.name }}-{{ .cluster.stage }}"
  operator:
    prometheus:
      serviceMonitor:
        enabled: true
        trustCRDsExist: true
        labels:
          monitoring.instance: "{{ .cluster.name }}-{{ .cluster.stage }}"
  {{- end }}
