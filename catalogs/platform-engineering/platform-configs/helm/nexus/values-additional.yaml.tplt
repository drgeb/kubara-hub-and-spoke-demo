# This file is rendered from a catalog template per-cluster.
{{- $cfg := index .cluster.services "nexus" "config" | default dict }}
{{- $host := $cfg.hostname | default (printf "nexus.%s" .cluster.dnsName) }}

ingress:
  additionalHosts:
    - my.nexus.me
  tls:
    - secretName: nexus-tls
      hosts:
        - {{ $host }}
        - my.nexus.me