# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $cfg := index .cluster.services "nexus" "config" | default dict }}
{{- $host := $cfg.hostname | default (printf "nexus.%s" .cluster.dnsName) }}

fullnameOverride: nexus

image:
  repository: sonatype/nexus3
  tag: latest

nexus:
  enabled: true
  cleanupWizard:
    enabled: false
  env:
    - name: INSTALL4J_ADD_VM_PARAMS
      value: "-Xms2703m -Xmx2703m -XX:MaxDirectMemorySize=2703m -Djava.util.prefs.userRoot=/nexus-data/javaprefs"
    - name: NEXUS_SECURITY_RANDOMPASSWORD
      value: "false"
    - name: NEXUS_SECURITY_DEFAULTPASSWORD
      value: {{ $cfg.adminPassword | default "Nexus12345" | quote }}
  properties:
    data:
      nexus.scripts.allowCreation: true
  persistence:
    enabled: true
    storageClass: ""
    size: "10Gi"
    accessMode: ReadWriteOnce
  nexusPort: 8081

ingress:
  enabled: true
  annotations:
    cert-manager.io/cluster-issuer: kubara-local-ca-issuer
  hostRepo: {{ $host }}
  hostPath: /
  ingressClassName: {{ .cluster.ingressClassName | default "traefik" }}
  tls:
    - secretName: nexus-tls
      hosts:
        - {{ $host }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"
