# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
#
# To customize values, add additional files named values-*.yaml to this
# directory.

{{- $cfg := index .cluster.services "openproject" "config" | default dict }}
{{- $host := $cfg.host | default (printf "openproject.%s" .cluster.dnsName) }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"

image:
  pullPolicy: IfNotPresent

openproject:
  https: true
  host: {{ $host }}
  hsts: true

  admin_user:
    secret: openproject-secrets
    password_reset: "false"
    name: {{ $cfg.adminName | default "OpenProject Administrator" | quote }}
    mail: {{ $cfg.adminEmail | default "admin@example.com" | quote }}

  secrets:
    secretKeyBase:
      existingSecret: openproject-secrets
      secretKey: secret-key-base

  cache:
    store: memcache

postgresql:
  bundled: false

  connection:
    host: {{ $cfg.database.host | default "postgresql.postgresql.svc.cluster.local" | quote }}
    port: {{ $cfg.database.port | default 5432 }}

  auth:
    existingSecret: openproject-postgresql
    secretKeys:
      adminPasswordKey: postgres-password
      userPasswordKey: password
    username: {{ $cfg.database.username | default "openproject" | quote }}
    database: {{ $cfg.database.name | default "openproject" | quote }}

ingress:
  enabled: true
  ingressClassName: {{ .cluster.ingressClassName | default "traefik" }}
  host: {{ $host }}
  path: /
  pathType: Prefix

  annotations:
    cert-manager.io/cluster-issuer: kubara-local-ca-issuer

  tls:
    enabled: true
    secretName: openproject-tls

persistence:
  enabled: true
  size: {{ $cfg.storage.size | default "20Gi" | quote }}
  accessModes:
    - ReadWriteOnce

workers:
  default:
    replicaCount: {{ $cfg.replicas | default 1 }}
