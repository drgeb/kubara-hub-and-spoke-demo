# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $cfg := index .cluster.services "kargo" "config" | default dict }}
{{- $host := $cfg.host | default (printf "kargo.%s" .cluster.dnsName) }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"

image:
  pullSecrets:
    - name: image-pull-secret

api:
  host: {{ $host }}
  basePath: ""
  secret:
    name: kargo-admin
  tls:
    enabled: false
  ingress:
    enabled: true
    ingressClassName: {{ .cluster.ingressClassName | default "traefik" }}
    tls:
      enabled: false
  rollouts:
    integrationEnabled: true

controller:
  argocd:
    integrationEnabled: true
  rollouts:
    integrationEnabled: true

externalWebhooksServer:
  tls:
    enabled: false
