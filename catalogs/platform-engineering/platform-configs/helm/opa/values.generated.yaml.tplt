# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $cfg := index .cluster.services "opa" "config" | default dict }}
{{- $host := $cfg.hostname | default (printf "opa.%s" .cluster.dnsName) }}

replicas: {{ $cfg.replicas | default 1 }}

# OPA server configuration — disable the default quickstart bundle from
# openpolicyagent.org (inaccessible in an airgapped kind cluster) and
# expose an extra HTTP port for the Traefik ingress.
opa:
  services: {}
  bundles: {}
  default_decision: ""

extraPorts:
  - port: 8080
    protocol: TCP
    name: http
    targetPort: 443

# Admission controller (ValidatingWebhookConfiguration)
admissionController:
  enabled: true
  failurePolicy: Ignore
  sideEffect: None

# kube-mgmt sidecar — syncs Kubernetes data into OPA
mgmt:
  enabled: true

# Metrics / ServiceMonitor (prometheus-operator)
prometheus:
  enabled: true
serviceMonitor:
  enabled: true

# Resource limits and requests
resources:
  limits:
    cpu: 100m
    memory: 128Mi
  requests:
    cpu: 50m
    memory: 64Mi

# Security context
securityContext:
  enabled: true
  runAsNonRoot: true
  runAsUser: 1000

# Pod disruption budget
podDisruptionBudget:
  enabled: true
  minAvailable: 1

# Ingress — not part of the upstream opa-kube-mgmt chart; used by our
# custom templates/ingress.yaml overlay.
ingress:
  enabled: true
  hostname: {{ $host }}
  ingressClassName: {{ .cluster.ingressClassName | default "traefik" }}
  annotations:
    {}
