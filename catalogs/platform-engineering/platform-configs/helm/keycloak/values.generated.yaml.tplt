# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
#
# To customize values, add additional files named values-*.yaml to this
# directory.

{{- $cfg := index .cluster.services "keycloak" "config" | default dict }}
{{- $host := $cfg.host | default (printf "keycloak.%s" .cluster.dnsName) }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"

production: true

proxyHeaders: xforwarded

auth:
  adminUser: {{ $cfg.adminUser | default "admin" | quote }}
  existingSecret: keycloak-credentials
  passwordSecretKey: admin-password

postgresql:
  enabled: false

externalDatabase:
  host: {{ $cfg.database.host | default "postgresql.postgresql.svc.cluster.local" | quote }}
  port: {{ $cfg.database.port | default 5432 }}
  database: {{ $cfg.database.name | default "keycloak" | quote }}
  username: {{ $cfg.database.username | default "keycloak" | quote }}
  user: {{ $cfg.database.username | default "keycloak" | quote }}
  existingSecret: keycloak-credentials
  existingSecretPasswordKey: db-password
  schema: public

replicaCount: {{ $cfg.replicas | default 1 }}

ingress:
  enabled: true
  ingressClassName: {{ .cluster.ingressClassName | default "traefik" }}
  hostname: {{ $host }}
  pathType: Prefix
  annotations:
    cert-manager.io/cluster-issuer: kubara-local-ca-issuer
  tls: true
