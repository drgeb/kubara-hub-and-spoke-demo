# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
# To customize values, add additional files named values-*.yaml to this
# directory.

{{- $cfg := index .cluster.services "forgejo" "config" | default dict }}
{{- $host := $cfg.host | default (printf "forgejo.%s" .cluster.dnsName) }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"

imagePullSecrets:
  - name: image-pull-secret

service:
  http:
    type: ClusterIP

ingress:
  enabled: true
  className: {{ .cluster.ingressClassName | default "traefik" }}
  annotations:
    cert-manager.io/cluster-issuer: kubara-local-ca-issuer
  hosts:
    - host: {{ $host }}
      paths:
        - path: /
          pathType: Prefix
          port: http
  tls:
    - secretName: forgejo-tls
      hosts:
        - {{ $host }}

gitea:
  admin:
    username: {{ $cfg.admin.username | default "gitea_admin" | quote }}
    existingSecret: forgejo-admin
    email: {{ $cfg.admin.email | default "admin@local" | quote }}
  env:
    - name: GITEA__database__PASSWD
      valueFrom:
        secretKeyRef:
          name: forgejo-credentials
          key: password
  config:
    server:
      DOMAIN: {{ $host }}
      ROOT_URL: http://{{ $host }}/
    database:
      DB_TYPE: postgres
      HOST: {{ $cfg.database.host | default "postgresql.postgresql.svc.cluster.local" | quote }}
      NAME: {{ $cfg.database.name | default "forgejo" | quote }}
      USER: {{ $cfg.database.user | default "app" | quote }}
      SSL_MODE: disable
