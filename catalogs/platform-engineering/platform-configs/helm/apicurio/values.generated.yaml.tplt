# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $cfg := index .cluster.services "apicurio" "config" | default dict }}
{{- $host := $cfg.hostname | default (printf "apicurio.%s" .cluster.dnsName) }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"

registry:
  enabled: true
  image:
    registry: "quay.io"
    repository: "apicurio/apicurio-registry"
    tag: {{ $cfg.image.tag | default "2.5.9.Final" | quote }}
  sql:
    url: {{ printf "jdbc:postgresql://%s:%d/apicurio" ($cfg.database.host | default "postgresql.postgresql.svc.cluster.local") ($cfg.database.port | default 5432) | quote }}
    username: {{ $cfg.database.username | default "apicurio" | quote }}
    password: {{ $cfg.database.password | default "ApicurioDB123!" | quote }}
  podSecurityContext:
    runAsNonRoot: true
    fsGroup: 1000
  securityContext:
    runAsNonRoot: true
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
    requests:
      cpu: 200m
      memory: 512Mi
  ingress:
    enabled: true
    ingressClassName: {{ .cluster.ingressClassName | default "traefik" }}
    host: {{ $host }}
    path: /
    tls: true
    annotations:
      cert-manager.io/cluster-issuer: kubara-local-ca-issuer

sync:
  enabled: {{ $cfg.sync.enabled | default false }}
