# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually in any way.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $harbor := (index .cluster.services "harbor" "config") -}}
{{- $tls := $harbor.tls | default (dict "enabled" true "issuerRef" (dict "kind" "ClusterIssuer" "name" "kubara-local-ca-issuer")) -}}
{{- $issuerRef := $tls.issuerRef | default (dict "kind" "ClusterIssuer" "name" "kubara-local-ca-issuer") -}}
{{- $ingressAnnotations := merge (dict "cert-manager.io/cluster-issuer" $issuerRef.name) ($harbor.networking.annotations | default (dict)) }}

expose:
  type: ingress
  tls:
    enabled: {{ $tls.enabled | default true }}
    certSource: {{ $harbor.tlsCertSource | default "auto" }}
    auto:
      commonName: "{{ $harbor.hostname }}"
    secret:
      secretName: ""
  ingress:
    className: "{{ .cluster.ingressClassName | default "traefik" }}"
    hosts:
      core: "{{ $harbor.hostname }}"
    annotations:
{{ toYaml $ingressAnnotations | indent 6 }}

externalURL: "https://{{ $harbor.hostname }}"
existingSecretAdminPassword: harbor-credentials
jobservice:
  initContainers:
  - name: wait-for-core
    image: busybox:1.36
    command:
    - sh
    - -c
    - |
      echo "Waiting for Harbor core to be ready..."
      until wget -qO- --no-check-certificate http://harbor-core:80/api/v2.0/ping >/dev/null 2>&1; do
        echo "  Harbor core not ready, retrying in 5s..."
        sleep 5
      done
      echo "Harbor core is ready."
database:
  type: internal
persistence:
  persistentVolumeClaim:
    database:
      {{- with $harbor.persistence.storageClass }}
      storageClass: {{ . | quote }}
      {{- end }}
      size: {{ $harbor.persistence.databaseSize | default "1Gi" | quote }}
    redis:
      {{- with $harbor.persistence.storageClass }}
      storageClass: {{ . | quote }}
      {{- end }}
      size: {{ $harbor.persistence.redisSize | default "1Gi" | quote }}
    registry:
      {{- with $harbor.persistence.storageClass }}
      storageClass: {{ . | quote }}
      {{- end }}
      size: {{ $harbor.persistence.registrySize | default "10Gi" | quote }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"
