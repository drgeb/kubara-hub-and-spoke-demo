# OpenBank (../apps/open-bank-oss) -> kubara-dev via Harbor, Kargo and Argo CD.
#
# What gets deployed: openbank-product-catalog, the one OpenBank module upstream
# ships for standalone use (PostgreSQL + any OIDC issuer, own Helm chart). The
# full platform in the README is 74 services on Kafka/Temporal/CNPG/... and does
# not fit a single-node kind cluster.
#
# Flow (all on the mesh, no public registry or git host):
#
#   ../apps/open-bank-oss --gradle--> fast-jar --buildx--> Harbor (platform-engineering)
#     Kargo Warehouse sees the new tag -> Freight -> Stage "dev" (auto-promote)
#     Stage commits stages/dev/values.yaml in Forgejo repo openbank-gitops
#     hub Argo CD (automated sync) renders the chart -> kubara-dev, namespace openbank
#
# First deploy:      just openbank-deploy-dev
# New version:       just openbank-release      (build + push; Kargo does the rest)
# Inspect / check:   just openbank-status | just openbank-test
#
# Needs in .env: HARBOR_ADMIN_*, FORGEJO_ADMIN_*, POSTGRES_PASSWORD and
# OPENBANK_CATALOG_DB_PASSWORD. Imported by the root Justfile, so it shares its
# variables. Implementation: z-demo-setup/scripts/open-bank-oss.sh.

# Path to the open-bank-oss checkout (sibling of this repo by default)
OBO_SRC := env_var_or_default("OBO_SRC", parent_directory(justfile_directory()) + "/apps/open-bank-oss")

[private]
_openbank step:
    @KCFG="{{ justfile_directory() }}/{{ KUBARA_KUBECONFIG }}" OBO_SRC="{{ OBO_SRC }}" \
    PE_DNS="{{ PLATFORM_ENGINEERING_DNS_NAME }}" DEV_DNS="{{ DEV_DNS_NAME }}" \
    PE_CTX="{{ PLATFORM_ENGINEERING_CONTEXT }}" DEV_CTX="{{ DEV_CONTEXT }}" HUB_CTX="{{ HUB_CONTEXT }}" \
    ARGO_DEST_CLUSTER="{{ DEV_NAME }}" \
        ./z-demo-setup/scripts/open-bank-oss.sh {{ step }}

# 1. Fetch the mesh CA (issuer of the Harbor/Forgejo/Keycloak certificates)
openbank-ca: (_openbank "ca")

# 2. Let containerd on every kind node pull from Harbor (trusts the mesh CA)
openbank-trust-nodes: (_openbank "trust-nodes")

# 3. Create the public Harbor project `openbank`
openbank-harbor: (_openbank "harbor")

# 4. Build the product-catalog fast-jar with Gradle (host JDK 25)
openbank-build: (_openbank "build")

# 5. Bake the image and push it to Harbor as kubara-<utc>-<git sha>
openbank-image: (_openbank "image")

# 6. Create the product_catalog role/database on kubara-dev and its Secret
openbank-db: (_openbank "db")

# 7. Seed the Forgejo repo openbank-gitops (chart + stages/dev/values.yaml)
openbank-gitops: (_openbank "gitops")

# 8. Register the repo and the dev Application in the hub's Argo CD
openbank-argocd: (_openbank "argocd")

# 9. Create the Kargo Project, git credentials, Warehouse and dev Stage
openbank-kargo: (_openbank "kargo")

# 10. OpenBank topics on kubara-dev's openbank-cluster (kubara kafka chart)
openbank-kafka: (_openbank "kafka")

# Show Kargo freight/promotions, the Argo CD apps, Kafka and the dev pods
openbank-status: (_openbank "status")

# Wait until the catalog answers on http://product-catalog.dev.kubara.test/
openbank-test: (_openbank "test")

# First deploy to kubara-dev: catalog (steps 1-9 + test), then Kafka (step 10)
openbank-deploy-dev: openbank-ca openbank-trust-nodes openbank-harbor openbank-build openbank-image openbank-db openbank-gitops openbank-argocd openbank-kargo openbank-test openbank-kafka

# Ship a new version: build + push; Kargo auto-promotes it to dev
openbank-release: openbank-build openbank-image
    @echo "Pushed. Kargo's Warehouse polls every 2m, then dev is promoted: just openbank-status"

# ── OpenBank domain services (see OPENBANK_SERVICES in z-demo-setup/scripts/open-bank-oss.sh)
#
# Same Harbor -> Kargo -> Argo CD flow as the catalog, one Warehouse + Stage
# (<svc>-dev) and one Argo CD app (openbank-<svc>-dev) per service, all from one
# generic chart (z-demo-setup/open-bank-oss/service-chart) in openbank-gitops.
# Each service gets its own database on the shared postgres, kubara-dev's Kafka
# and the mesh Keycloak realm `openbank`. campaign (Temporal + ClickHouse) and
# billing (OpenBao) are not included: the mesh does not run those.
#
# Prereq: the catalog flow (just openbank-deploy-dev) has set up the CA, Harbor,
# the gitops repo, the Argo CD project and the Kargo project.
#
# One service:        just openbank-svc-deploy engagement
# All services:       just openbank-services-deploy
# New version:        just openbank-svc-release engagement   (Kargo promotes it)
# Test:               just openbank-svc-test engagement | just openbank-services-test

[private]
_openbank_svc step svc="":
    @KCFG="{{ justfile_directory() }}/{{ KUBARA_KUBECONFIG }}" OBO_SRC="{{ OBO_SRC }}" \
    PE_DNS="{{ PLATFORM_ENGINEERING_DNS_NAME }}" DEV_DNS="{{ DEV_DNS_NAME }}" \
    PE_CTX="{{ PLATFORM_ENGINEERING_CONTEXT }}" DEV_CTX="{{ DEV_CONTEXT }}" HUB_CTX="{{ HUB_CONTEXT }}" \
    ARGO_DEST_CLUSTER="{{ DEV_NAME }}" \
        ./z-demo-setup/scripts/open-bank-oss-services.sh {{ step }} {{ svc }}

# List the OpenBank services the svc recipes know
openbank-svc-list: (_openbank_svc "list")

# Keycloak realm `openbank` + client `openbank-services` (secret -> openbank/openbank-oidc)
openbank-svc-keycloak: (_openbank_svc "keycloak")

# Commit the generic openbank-service chart to openbank-gitops
openbank-svc-chart: (_openbank_svc "chart")

# Demo Temporal dev server on kubara-dev (gitops chart + Argo CD app + namespace check)
openbank-temporal: (_openbank_svc "temporal")

# Test the demo Temporal: pod ready, every OpenBank namespace registered
openbank-temporal-test: (_openbank_svc "temporal-test")

# Gradle fast-jar of one service
openbank-svc-build svc: (_openbank_svc "build" svc)

# Bake + push one service image to Harbor (Kargo's Warehouse picks it up)
openbank-svc-image svc: (_openbank_svc "image" svc)

# Database + credentials Secret for one service on kubara-dev
openbank-svc-db svc: (_openbank_svc "db" svc)

# Write stages/dev/<svc>/values.yaml (+ seed image.yaml) in openbank-gitops
openbank-svc-gitops svc: (_openbank_svc "gitops" svc)

# Hub Argo CD Application openbank-<svc>-dev
openbank-svc-argocd svc: (_openbank_svc "argocd" svc)

# Kargo Warehouse <svc>-service + Stage <svc>-dev (auto-promotion)
openbank-svc-kargo svc: (_openbank_svc "kargo" svc)

# Test one service: Argo healthy, pod ready, Flyway, Kafka group, OIDC via ingress
openbank-svc-test svc: (_openbank_svc "test" svc)

# Deploy one service end to end (build, image, db, gitops, argocd, kargo, test)
openbank-svc-deploy svc: openbank-svc-keycloak openbank-svc-chart (_openbank_svc "deploy" svc)

# Ship a new version of one service: build + push; Kargo auto-promotes <svc>-dev
openbank-svc-release svc: (openbank-svc-build svc) (openbank-svc-image svc)
    @echo "Pushed. Warehouse {{ svc }}-service polls every 2m, then {{ svc }}-dev is promoted: just openbank-services-status"

# Deploy every registered service, one after another
openbank-services-deploy: openbank-svc-keycloak openbank-svc-chart openbank-temporal
    #!/usr/bin/env bash
    set -euo pipefail
    for s in $(just openbank-svc-list); do just _openbank_svc deploy "$s"; done

# Test every registered service; reports all failures, exits non-zero if any
openbank-services-test:
    #!/usr/bin/env bash
    set -uo pipefail
    failed=""
    for s in $(just openbank-svc-list); do just _openbank_svc test "$s" || failed="$failed $s"; done
    if [ -n "$failed" ]; then echo "FAILED:$failed" >&2; exit 1; fi
    echo "All OpenBank services passed."

# Kargo stages, Argo CD apps and pods for every service
openbank-services-status: (_openbank_svc "status")
