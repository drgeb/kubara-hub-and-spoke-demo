# Self-contained wildcard DNS for the kubara hub-and-spoke demo.
# Resolves <svc>.<cluster>.kubara.test -> that cluster's traefik LoadBalancer
# and installs macOS /etc/resolver overrides for kubara.test and my.nexus.me.

KUBECONFIG := parent_directory(justfile_directory()) + "/.local/kind.kubeconfig"
CONF := justfile_directory() + "/config/dnsmasq.conf"
RESOLVER_DIR := justfile_directory() + "/resolver"
ETC_RESOLVER_DIR := "/etc/resolver"
PID_FILE := justfile_directory() + "/.dnsmasq.pid"
RESOLVER_DOMAINS := "kubara.test me"

default:
    @just --list

# Install ./resolver/* into /etc/resolver/ and flush the DNS cache (sudo)
setup-resolver:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Installing resolvers: {{ RESOLVER_DOMAINS }}"
    sudo mkdir -p "{{ ETC_RESOLVER_DIR }}"
    for domain in {{ RESOLVER_DOMAINS }}; do
        [ -f "{{ RESOLVER_DIR }}/${domain}" ] || { echo "missing {{ RESOLVER_DIR }}/${domain}" >&2; exit 1; }
        sudo cp "{{ RESOLVER_DIR }}/${domain}" "{{ ETC_RESOLVER_DIR }}/${domain}"
        echo "Installed {{ ETC_RESOLVER_DIR }}/${domain}"
    done
    if [ -f "{{ ETC_RESOLVER_DIR }}/traefik.me" ]; then
        sudo rm -f "{{ ETC_RESOLVER_DIR }}/traefik.me"
        echo "Removed stale {{ ETC_RESOLVER_DIR }}/traefik.me"
    fi
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
    echo "DNS resolvers configured for *.kubara.test and my.nexus.me"

# Start dnsmasq with config/dnsmasq.conf (sudo, from config/dnsmasq)
start-dnsmasq: setup-resolver
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f "{{ PID_FILE }}" ] && ps -p "$(cat "{{ PID_FILE }}")" -o pid= >/dev/null 2>&1; then
        echo "dnsmasq already running (PID: $(cat "{{ PID_FILE }}"))"
        exit 0
    fi
    RUNNING_PID=$(pgrep -x dnsmasq 2>/dev/null || true)
    if [ -n "$RUNNING_PID" ]; then
        echo "dnsmasq already running (PID: $RUNNING_PID) - skipping start"
        exit 0
    fi
    [ -f "{{ CONF }}" ] || { echo "dnsmasq.conf not found at {{ CONF }}" >&2; exit 1; }
    echo "Starting dnsmasq for *.kubara.test and my.nexus.me..."
    sudo "$(command -v dnsmasq)" --conf-file="{{ CONF }}" --pid-file="{{ PID_FILE }}"
    echo "dnsmasq started. *.kubara.test and my.nexus.me resolve via 127.0.0.1"

# Stop dnsmasq (sudo)
stop-dnsmasq:
    #!/usr/bin/env bash
    set -euo pipefail
    found=""
    if [ -f "{{ PID_FILE }}" ]; then
        PID=$(cat "{{ PID_FILE }}")
        if ps -p "$PID" -o pid= >/dev/null 2>&1; then
            echo "Stopping dnsmasq (PID: $PID)..."
            sudo kill "$PID"
            for _ in 1 2 3 4 5; do
                ps -p "$PID" -o pid= >/dev/null 2>&1 || break
                sleep 0.2
            done
            found="$PID"
        else
            echo "PID file present but process not running; removing stale PID file"
        fi
        sudo rm -f "{{ PID_FILE }}"
    fi
    RUNNING_PID=$(pgrep -x dnsmasq 2>/dev/null || true)
    if [ -n "$RUNNING_PID" ]; then
        echo "Stopping dnsmasq (PID: $RUNNING_PID)..."
        sudo pkill -x dnsmasq
        found="$found $RUNNING_PID"
    fi
    if [ -n "$found" ]; then echo "dnsmasq stopped"; else echo "dnsmasq not running"; fi

    # Flush macOS DNS cache
    echo "Flushing macOS DNS cache..."
    sudo dscacheutil -flushcache || true
    sudo killall -HUP mDNSResponder || true
# Show dnsmasq status
status-dnsmasq:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f "{{ PID_FILE }}" ] && ps -p "$(cat "{{ PID_FILE }}")" -o pid= >/dev/null 2>&1; then
        echo "dnsmasq is running (PID: $(cat "{{ PID_FILE }}"))"
        pgrep -lx dnsmasq
    else
        RUNNING_PID=$(pgrep -x dnsmasq 2>/dev/null || true)
        if [ -n "$RUNNING_PID" ]; then
            echo "dnsmasq is running without PID file (PID: $RUNNING_PID)"
            pgrep -lx dnsmasq
        else
            echo "dnsmasq is not running"
            exit 1
        fi
    fi

# Rewrite the address=/<cluster>.kubara.test lines from the live traefik
# LoadBalancer IPs (plus the forgejo SSH LB on spoke-1) and reload dnsmasq.
# Run after rebuilding/restarting clusters.
refresh-lb-hosts:
    #!/usr/bin/env bash
    set -euo pipefail
    KCFG="{{ KUBECONFIG }}"
    CONF="{{ CONF }}"
    [ -f "$KCFG" ] || { echo "kubeconfig not found: $KCFG" >&2; exit 1; }

    ip_of() {
        kubectl --kubeconfig "$KCFG" --context "$1" get svc/traefik -n traefik \
            -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true
    }

    ROWS=(
        "hub.kubara.test kind-hub"
        "spoke-1.kubara.test kind-kubara-spoke-1"
        "spoke-2.kubara.test kind-kubara-spoke-2"
        "dev.kubara.test kind-kubara-dev"
        "staging.kubara.test kind-kubara-staging"
        "prod.kubara.test kind-kubara-prod"
    )

    # LB IPs appear ~30-90s after cluster nodes start; wait for each one so the
    # map is complete before we rewrite it. Any required IP that stays missing
    # aborts the refresh instead of leaving a stale partial map in place.
    RESOLVE_ATTEMPTS=25

    ip_of_or_wait() {
        local ctx="$1" ip=""
        for _ in $(seq 1 "$RESOLVE_ATTEMPTS"); do
            ip=$(ip_of "$ctx")
            [ -n "$ip" ] && break
            sleep 4
        done
        printf '%s' "$ip"
    }

    DIMS=()
    IPS=()
    MISSING=()
    for row in "${ROWS[@]}"; do
        dom="${row%% *}"; ctx="${row#* }"
        ip=$(ip_of_or_wait "$ctx")
        if [ -n "$ip" ]; then
            DIMS+=("$dom"); IPS+=("$ip")
        else
            MISSING+=("$dom ($ctx)")
        fi
    done

    spoke1_ip=""
    for i in "${!DIMS[@]}"; do
        if [ "${DIMS[$i]}" = "spoke-1.kubara.test" ]; then
            spoke1_ip="${IPS[$i]}"
            break
        fi
    done

    FORGEJO_SSH_HOST="forgejo-ssh.me"
    forgejo_ip=$(kubectl --kubeconfig "$KCFG" --context kind-kubara-spoke-1 \
        -n forgejo get svc forgejo-ssh -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)
    if [ -z "$forgejo_ip" ]; then
        for _ in $(seq 1 "$RESOLVE_ATTEMPTS"); do
            forgejo_ip=$(kubectl --kubeconfig "$KCFG" --context kind-kubara-spoke-1 \
                -n forgejo get svc forgejo-ssh -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)
            [ -n "$forgejo_ip" ] && break
            sleep 4
        done
    fi

    if [ "${#MISSING[@]}" -gt 0 ] || [ -z "$forgejo_ip" ]; then
        echo "ERROR: cannot read live LoadBalancer IPs; refusing to rewrite $CONF with a stale/partial map" >&2
        for m in "${MISSING[@]}"; do
            echo "  missing traefik LB IP: $m" >&2
        done
        if [ -z "$forgejo_ip" ]; then
            echo "  missing forgejo-ssh LB IP (kind-kubara-spoke-1/forgejo)" >&2
        fi
        echo "NOTE: LB IPs are assigned ~30-90s after cluster nodes start." >&2
        echo "If clusters just restarted, wait and re-run this recipe." >&2
        exit 1
    fi

    for i in "${!DIMS[@]}"; do
        echo "${DIMS[$i]} -> ${IPS[$i]}"
    done
    echo "$FORGEJO_SSH_HOST -> $forgejo_ip"

    tmp=$(mktemp)
    cp "$CONF" "$tmp"
    for i in "${!DIMS[@]}"; do
        dom="${DIMS[$i]}"; ip="${IPS[$i]}"
        if grep -q "address=/$dom/" "$tmp"; then
            sed -i.bak "s#^address=/$dom/.*#address=/$dom/$ip#" "$tmp"
        else
            printf 'address=/%s/%s\n' "$dom" "$ip" >> "$tmp"
        fi
    done

    if grep -q '^address=/my\.nexus\.me/' "$tmp"; then
        sed -i.bak "s#^address=/my\.nexus\.me/.*#address=/my.nexus.me/$spoke1_ip#" "$tmp"
    else
        printf 'address=/my.nexus.me/%s\n' "$spoke1_ip" >> "$tmp"
    fi

    if grep -q "^address=/$FORGEJO_SSH_HOST/" "$tmp"; then
        sed -i.bak "s#^address=/$FORGEJO_SSH_HOST/.*#address=/$FORGEJO_SSH_HOST/$forgejo_ip#" "$tmp"
    else
        printf 'address=/%s/%s\n' "$FORGEJO_SSH_HOST" "$forgejo_ip" >> "$tmp"
    fi
    rm -f "$tmp.bak"
    mv "$tmp" "$CONF"
    echo "Updated $CONF"

    PID_FILE="{{ PID_FILE }}"
    if [ -f "$PID_FILE" ] && ps -p "$(cat "$PID_FILE")" -o pid= >/dev/null 2>&1; then
        echo "Restarting dnsmasq (PID: $(cat "$PID_FILE"))..."
        sudo kill "$(cat "$PID_FILE")"
        sleep 0.5
    else
        RUNNING_PID=$(pgrep -x dnsmasq 2>/dev/null || true)
        if [ -n "$RUNNING_PID" ]; then
            echo "Restarting dnsmasq (PID: $RUNNING_PID)..."
            sudo kill "$RUNNING_PID"
            sleep 0.5
        else
            echo "dnsmasq not running - it will be started"
        fi
    fi
    sudo "$(command -v dnsmasq)" --conf-file="$CONF" --pid-file="$PID_FILE"
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
    echo "DNS cache flushed"